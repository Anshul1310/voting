# ==============================================================================
# PULSEVOTE CLIENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# For Local Development:
# Leave this blank or commented out. Vite's proxy in vite.config.js will
# automatically forward all requests to http://localhost:5000.
# VITE_BACKEND_URL=

# For Production (e.g., when deployed on Vercel with backend on EC2):
# Set this to your EC2 backend IP address or your custom domain / Cloudflare tunnel URL:
# Examples:
# VITE_BACKEND_URL=http://54.123.45.67:5000
# VITE_BACKEND_URL=https://api.yourdomain.com
# VITE_BACKEND_URL=https://your-tunnel-name.trycloudflare.com
VITE_BACKEND_URL=http://YOUR_EC2_PUBLIC_IP:5000
